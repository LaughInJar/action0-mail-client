{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "What the desktop app's main window may use: exactly the plugins action0 calls.",
  "platforms": ["linux", "macOS", "windows"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "opener:default",
    "dialog:allow-save",
    "fs:allow-write-file",
    "notification:default",
    "autostart:default",
    "updater:default",
    "process:allow-restart"
  ]
}
