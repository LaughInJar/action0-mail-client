{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "action0",
  "mainBinaryName": "action0",
  "version": "../package.json",
  "identifier": "app.action0.mail",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "action0",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 480,
        "visible": false,
        "dragDropEnabled": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data: blob: https: http:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "frame-src": "'self' blob:",
        "media-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["style-src"],
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "A keyboard-first mail and calendar client",
    "longDescription": "action0 is a mail and calendar client for Gmail, Outlook and Microsoft 365 with keyboard shortcuts everywhere.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "section": "mail" }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["mailto"] }
    },
    "updater": {
      "endpoints": [
        "https://github.com/LaughInJar/action0-mail-client/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2MDEwN0M1RjBFNjFDMDQKUldRRUhPYnd4UWNCZGtyTy9lc1NZa2M4SzJuUW5ycUQrV2NHbENlOXlxd3ZDT3dJTkQ3eUxqNUsK"
    }
  }
}
