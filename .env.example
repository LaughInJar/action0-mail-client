# OAuth 2.0 client ID of type "Web application" from Google Cloud Console.
# Copy this file to .env.local and fill it in. The client ID is not a secret.
VITE_GOOGLE_CLIENT_ID=

# Application (client) ID of the Microsoft Entra app registration (type
# "Single-page application"). Also not a secret.
VITE_MICROSOFT_CLIENT_ID=

# Desktop app only: OAuth client of type "Desktop app" from Google Cloud
# Console, and its secret (Google says desktop secrets aren't confidential).
VITE_GOOGLE_DESKTOP_CLIENT_ID=
VITE_GOOGLE_DESKTOP_CLIENT_SECRET=
